# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=claims_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/claims_db

# Mailpit (Local SMTP Mock)
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_URL=http://localhost:8025

# Observability (Arize Phoenix)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=claims-agent

# Model & Embeddings Configuration
# Options: google-genai, openai, ollama, local
MOCK_LLM=true
LLM_PROVIDER=google-genai
GEMINI_API_KEY=
OPENAI_API_KEY=
EMBEDDING_DIMENSION=768
